# Copy to `.env` to override the lab's settings: `cp .env.example .env`
# `.env` is git-ignored. Never commit it, and never put real cloud credentials in this file.
#
# Every value below is optional. When unset, compose.yaml uses local-only development defaults
# (access key "projlab") that only work against the lab's own object storage.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=lakehouse

# Host ports (change them if already in use on your machine).
# JUPYTER_PORT=8888
# SPARK_UI_PORT=4040
# JupyterLab login token (local-only default: projlab).
# JUPYTER_TOKEN=
# Memory for the Spark driver inside the workspace.
# SPARK_DRIVER_MEMORY=2g

# PostgreSQL with pgvector (the product index). Local-only defaults: projlab / projlab / projlab.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
